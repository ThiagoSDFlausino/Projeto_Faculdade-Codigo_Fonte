        raise HTTPException(status_code=404, detail="Agendamento não encontrado")
    await db.appointments.delete_one({"id": appt_id})
    return {"ok": True}


# ---------------- Dashboard (role-aware) ----------------
async def admin_dashboard():
    txs = await db.transactions.find({}, {"_id": 0}).to_list(5000)
    receita = sum(t["amount"] for t in txs if t["type"] == "receita" and t["status"] == "Pago")
    despesa = sum(t["amount"] for t in txs if t["type"] == "despesa" and t["status"] == "Pago")
    a_receber = sum(t["amount"] for t in txs if t["type"] == "receita" and t["status"] in ("Pendente", "Atrasado"))
    a_pagar = sum(t["amount"] for t in txs if t["type"] == "despesa" and t["status"] in ("Pendente", "Atrasado"))
    months_pt = ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun", "Jul", "Ago", "Set", "Out", "Nov", "Dez"]
    monthly = {}
    for t in txs:
        d = t.get("due_date") or t.get("paid_date") or ""
        if len(d) >= 7:
            key = d[:7]
            monthly.setdefault(key, {"receita": 0, "despesa": 0})
            monthly[key]["receita" if t["type"] == "receita" else "despesa"] += t["amount"]
    chart = []
    for key in sorted(monthly.keys())[-6:]:
        y, m = key.split("-")
        chart.append({"mes": months_pt[int(m) - 1], "receita": round(monthly[key]["receita"], 2),
                      "despesa": round(monthly[key]["despesa"], 2)})
    proc = {}
    for a in await db.appointments.find({}, {"_id": 0}).to_list(5000):
        proc.setdefault(a["procedure"], 0)
        proc[a["procedure"]] += a.get("value", 0)
    proc_chart = [{"name": k, "value": round(v, 2)} for k, v in sorted(proc.items(), key=lambda x: -x[1])[:6]]
    low_stock = await db.products.count_documents({"$expr": {"$lte": ["$quantity", "$min_quantity"]}})
    return {"role": "admin", "receita": round(receita, 2), "despesa": round(despesa, 2),
            "lucro": round(receita - despesa, 2), "a_receber": round(a_receber, 2),
            "a_pagar": round(a_pagar, 2), "total_clientes": await db.clientes.count_documents({}),
            "agendamentos_ativos": await db.appointments.count_documents({"status": {"$in": ["Agendado", "Confirmado"]}}),
            "chart": chart, "procedimentos": proc_chart,
            "aniversariantes": await aniversariantes_mes(), "estoque_baixo": low_stock}

def _today_str():
    return date.today().isoformat()

async def aniversariantes_mes():
    mes = f"-{date.today().month:02d}-"
    out = []
    for c in await db.clientes.find({}, {"_id": 0}).to_list(2000):
        b = c.get("birthdate", "")
        if len(b) == 10 and b[4:8] == mes:
            out.append({"name": c["name"], "day": int(b[8:10]), "photo": c.get("photo", ""), "id": c["id"]})
    out.sort(key=lambda x: x["day"])
    return out

async def sec_dashboard():
    hoje = _today_str()
    proximos = await db.appointments.find(
        {"datetime": {"$gte": hoje}, "status": {"$in": ["Agendado", "Confirmado"]}},
        {"_id": 0}).sort("datetime", 1).to_list(8)
    hoje_count = await db.appointments.count_documents({"datetime": {"$regex": f"^{hoje}"}})
    return {"role": "secretaria", "total_clientes": await db.clientes.count_documents({}),
            "agendamentos_ativos": await db.appointments.count_documents({"status": {"$in": ["Agendado", "Confirmado"]}}),
            "agendamentos_hoje": hoje_count, "proximos": proximos,
            "aniversariantes": await aniversariantes_mes()}

async def pro_dashboard(user):
    hoje = _today_str()
    mine = {"professional_id": user["id"]}
    proximos = await db.appointments.find(
        {**mine, "datetime": {"$gte": hoje}, "status": {"$in": ["Agendado", "Confirmado"]}},
        {"_id": 0}).sort("datetime", 1).to_list(8)
    hoje_count = await db.appointments.count_documents({**mine, "datetime": {"$regex": f"^{hoje}"}})
    mes = hoje[:7]
    sessoes_mes = await db.sessoes.find({**mine, "date": {"$regex": f"^{mes}"}}, {"_id": 0}).to_list(500)
    pct = user.get("commission_pct", 0) / 100.0
    comissao = sum(s.get("value", 0) for s in sessoes_mes) * pct
    return {"role": "profissional", "nome": user["name"], "specialty": user.get("specialty", ""),
            "agendamentos_hoje": hoje_count,
            "agendamentos_ativos": await db.appointments.count_documents({**mine, "status": {"$in": ["Agendado", "Confirmado"]}}),
            "sessoes_mes": len(sessoes_mes), "comissao_mes": round(comissao, 2),
            "commission_pct": user.get("commission_pct", 0), "proximos": proximos}

@api_router.get("/dashboard")
async def dashboard(user: dict = Depends(get_current_user)):
    if user["role"] == "profissional":
        return await pro_dashboard(user)
    if user["role"] == "secretaria":
        return await sec_dashboard()
    return await admin_dashboard()


# ---------------- Comissões ----------------
@api_router.get("/commissions")
async def commissions(user: dict = Depends(get_current_user)):
    if user["role"] == "secretaria":
        raise HTTPException(status_code=403, detail="Acesso negado para o seu perfil")
    profs = await db.users.find({"role": "profissional"}, {"_id": 0}).to_list(200)
    prof_map = {p["id"]: p for p in profs}
    q = {}
    if user["role"] == "profissional":
        q["professional_id"] = user["id"]
    sessoes = await db.sessoes.find(q, {"_id": 0}).to_list(5000)
    agg = {}
    for s in sessoes:
        pid = s.get("professional_id")
        if not pid or pid not in prof_map:
            continue
        agg.setdefault(pid, {"faturado": 0, "sessoes": 0})
        agg[pid]["faturado"] += s.get("value", 0)
        agg[pid]["sessoes"] += 1
    result = []
    for pid, v in agg.items():
        p = prof_map[pid]
        pct = p.get("commission_pct", 0)
        result.append({"professional_id": pid, "name": p["name"], "specialty": p.get("specialty", ""),
                       "commission_pct": pct, "faturado": round(v["faturado"], 2),
                       "sessoes": v["sessoes"], "comissao": round(v["faturado"] * pct / 100.0, 2)})
    result.sort(key=lambda x: -x["comissao"])
    return {"role": user["role"], "items": result,
            "total_comissao": round(sum(r["comissao"] for r in result), 2),
            "total_faturado": round(sum(r["faturado"] for r in result), 2)}


# ---------------- AI ----------------
@api_router.post("/ai/client-summary")
async def ai_client_summary(inp: AISummaryInput, user: dict = Depends(get_current_user)):
    cliente = await db.clientes.find_one({"id": inp.cliente_id}, {"_id": 0})
    if not cliente:
        raise HTTPException(status_code=404, detail="Cliente não encontrado")
    sessoes = await db.sessoes.find({"cliente_id": inp.cliente_id}, {"_id": 0}).to_list(100)
    anamneses = await db.anamneses.find({"cliente_id": inp.cliente_id}, {"_id": 0}).to_list(100)
    appts = await db.appointments.find({"cliente_id": inp.cliente_id}, {"_id": 0}).to_list(100)
    contexto = f"""Cliente: {cliente['name']}
Status: {cliente.get('status')}
Total gasto (LTV): R$ {cliente.get('total_spent', 0):.2f}
Tags: {', '.join(cliente.get('tags', []))}
Observações: {cliente.get('notes', '')}

Fichas de anamnese: {anamneses}

Sessões realizadas: {sessoes}

Agendamentos: {appts}
"""
    system = ("Você é a BellaAI, assistente de uma clínica de estética premium no Brasil. "
              "Gere um resumo profissional e acolhedor do cliente para a equipe. "
              "Responda SEMPRE em português do Brasil, em markdown, com as seções: "
              "**Resumo do Cliente**, **Procedimentos Recomendados** (lista com justificativa), "
              "**Alerta de Retorno** (quando reengajar) e **Mensagem Personalizada** (rascunho curto e caloroso "
              "para enviar via WhatsApp). Seja específico e use terminologia estética adequada.")
    try:
        chat = LlmChat(api_key=EMERGENT_LLM_KEY, session_id=f"summary-{inp.cliente_id}",
                       system_message=system).with_model("anthropic", "claude-sonnet-4-6")
        resp = await chat.send_message(UserMessage(text=contexto))
        return {"summary": resp}
    except Exception as e:
        logger.error(f"AI error: {e}")
        raise HTTPException(status_code=500, detail=f"Erro ao gerar resumo com IA: {str(e)}")


