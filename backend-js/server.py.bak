@api_router.post("/whatsapp/enviar")
async def send_wa_message(inp: WhatsAppSendInput, user: dict = Depends(require_roles("admin", "secretaria"))):
    conversa_id = inp.conversa_id
    if not conversa_id:
        if not inp.telefone:
            raise HTTPException(status_code=400, detail="Informe telefone ou conversa")
        existing = await db.whatsapp_conversas.find_one({"telefone": inp.telefone}, {"_id": 0})
        if existing:
            conversa_id = existing["id"]
        else:
            conv = WhatsAppConversa(telefone=inp.telefone, nome=inp.nome or inp.telefone, cliente_id=inp.cliente_id,
                                    ultima_mensagem=inp.conteudo)
            await db.whatsapp_conversas.insert_one(conv.model_dump())
            conversa_id = conv.id
    msg = WhatsAppMensagem(conversa_id=conversa_id, direcao="out", conteudo=inp.conteudo, status="enviada")
    await db.whatsapp_mensagens.insert_one(msg.model_dump())
    await db.whatsapp_conversas.update_one({"id": conversa_id}, {"$set": {
        "ultima_mensagem": inp.conteudo, "updated_at": now_iso()
    }})
    # tentativa Cloud API se token real no env
    token = os.environ.get("WHATSAPP_TOKEN", "")
    cfg = await db.whatsapp_config.find_one({"id": "default"}, {"_id": 0}) or {}
    if token or (cfg.get("access_token") and not cfg.get("modo_demo", True)):
        try:
            import requests as req
            phone_id = cfg.get("phone_number_id") or os.environ.get("WHATSAPP_PHONE_ID", "")
            tok = token or cfg.get("access_token")
            conv = await db.whatsapp_conversas.find_one({"id": conversa_id}, {"_id": 0})
            if phone_id and tok and conv:
                req.post(
                    f"https://graph.facebook.com/v18.0/{phone_id}/messages",
                    headers={"Authorization": f"Bearer {tok}"},
                    json={"messaging_product": "whatsapp", "to": conv["telefone"].replace(" ", "").replace("(", "").replace(")", "").replace("-", ""),
                          "type": "text", "text": {"body": inp.conteudo}},
                    timeout=10,
                )
        except Exception as e:
            logger.warning("WhatsApp Cloud API falhou (modo demo ok): %s", e)
    return msg

