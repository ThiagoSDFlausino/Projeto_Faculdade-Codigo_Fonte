@api_router.get("/whatsapp/webhook")
async def wa_webhook_verify(request: Request):
    params = request.query_params
    mode = params.get("hub.mode")
    token = params.get("hub.verify_token")
    challenge = params.get("hub.challenge")
    cfg = await db.whatsapp_config.find_one({"id": "default"}, {"_id": 0}) or {}
    expected = cfg.get("verify_token") or "bella_verify"
    if mode == "subscribe" and token == expected:
        return int(challenge) if challenge and challenge.isdigit() else challenge
    raise HTTPException(status_code=403, detail="Verify token inválido")

@api_router.post("/whatsapp/webhook")
async def wa_webhook_receive(request: Request):
    try:
        body = await request.json()
    except Exception:
        body = {}
    # stub: grava mensagens inbound se vierem no formato Meta
    try:
        entries = body.get("entry") or []
        for entry in entries:
            for change in entry.get("changes") or []:
                value = change.get("value") or {}
                for m in value.get("messages") or []:
                    phone = m.get("from", "")
                    text = (m.get("text") or {}).get("body", "")
                    if not phone:
                        continue
                    conv = await db.whatsapp_conversas.find_one({"telefone": {"$regex": phone[-8:]}}, {"_id": 0})
                    if not conv:
                        conv_obj = WhatsAppConversa(telefone=phone, nome=phone, ultima_mensagem=text)
                        await db.whatsapp_conversas.insert_one(conv_obj.model_dump())
                        conversa_id = conv_obj.id
                    else:
                        conversa_id = conv["id"]
                        await db.whatsapp_conversas.update_one({"id": conversa_id}, {"$set": {
                            "ultima_mensagem": text, "updated_at": now_iso()
                        }})
                    msg = WhatsAppMensagem(conversa_id=conversa_id, direcao="in", conteudo=text, status="recebida")
                    await db.whatsapp_mensagens.insert_one(msg.model_dump())
    except Exception as e:
        logger.warning("Webhook parse: %s", e)
    return {"ok": True}


app.include_router(api_router)
app.add_middleware(
    CORSMiddleware,
    allow_credentials=True,
    allow_origins=os.environ.get('CORS_ORIGINS', '*').split(','),
    allow_methods=["*"],
    allow_headers=["*"],
)


# ---------------- Seed ----------------
async def seed():
    admin_email = os.environ.get("ADMIN_EMAIL").lower()
    admin_password = os.environ.get("ADMIN_PASSWORD")
    existing = await db.users.find_one({"email": admin_email})
    if not existing:
        await db.users.insert_one({"id": str(uuid.uuid4()), "email": admin_email,
                                   "password_hash": hash_password(admin_password),
                                   "name": "Faculdade (Dono)", "role": "admin", "specialty": "",
                                   "commission_pct": 0, "photo": "", "active": True, "created_at": now_iso()})
    else:
        upd = {"role": "admin", "active": True}
        if not verify_password(admin_password, existing["password_hash"]):
            upd["password_hash"] = hash_password(admin_password)
        await db.users.update_one({"email": admin_email}, {"$set": upd})

    # staff
    staff_defs = [
        ("juliana@faculdade.com", "Dra. Juliana Mendes", "profissional", "Biomédica Esteta", 35,
         "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80"),
        ("lucas@faculdade.com", "Dr. Lucas Ferraz", "profissional", "Dermatologista", 30,
         "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&q=80"),
        ("recepcao@faculdade.com", "Ana Recepção", "secretaria", "Recepcionista", 0, ""),
    ]
    prof_ids = {}
    for email, name, role, spec, pct, photo in staff_defs:
        u = await db.users.find_one({"email": email})
        if not u:
            uid = str(uuid.uuid4())
            await db.users.insert_one({"id": uid, "email": email, "password_hash": hash_password("bella123"),
                                       "name": name, "role": role, "specialty": spec, "commission_pct": pct,
                                       "photo": photo, "active": True, "created_at": now_iso()})
            prof_ids[name] = uid
        else:
            prof_ids[name] = u["id"]

    if await db.clientes.count_documents({}) > 0:
        return

    today = date.today()

    def dstr(days):
        return (today + timedelta(days=days)).isoformat()

    clientes_seed = [
        {"name": "Camila Ribeiro", "phone": "(11) 98765-4321", "email": "camila.ribeiro@email.com",
         "photo": "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=200&q=80",
         "tags": ["VIP", "Fidelidade Ouro"], "status": "Ativo", "total_spent": 0.0,
         "notes": "Cliente desde 2022, prefere atendimento no período da tarde.", "birthdate": "1990-04-12"},
        {"name": "Fernanda Costa", "phone": "(11) 91234-5678", "email": "fernanda.costa@email.com",
         "photo": "", "tags": ["Novo"], "status": "Ativo", "total_spent": 0.0,
         "notes": "Indicada por Camila Ribeiro.", "birthdate": "1995-09-30"},
        {"name": "Patrícia Almeida", "phone": "(11) 99887-6655", "email": "patricia.almeida@email.com",
         "photo": "", "tags": ["VIP"], "status": "Ativo", "total_spent": 0.0,
         "notes": "Faz harmonização facial trimestral.", "birthdate": "1988-01-22"},
        {"name": "Juliana Souza", "phone": "(11) 97777-1122", "email": "juliana.souza@email.com",
         "photo": "", "tags": ["Fidelidade Prata"], "status": "Inativo", "total_spent": 0.0,
         "notes": "Sem retorno há 4 meses.", "birthdate": "1992-07-15"},
        {"name": "Roberta Lima", "phone": "(11) 96543-2211", "email": "roberta.lima@email.com",
         "photo": "", "tags": ["Novo"], "status": "Ativo", "total_spent": 0.0,
         "notes": "Primeira sessão de limpeza de pele.", "birthdate": "1998-11-05"},
    ]
    cli_objs = [Cliente(**c) for c in clientes_seed]
    await db.clientes.insert_many([c.model_dump() for c in cli_objs])
    ids = {c.name: c.id for c in cli_objs}
    # garante ao menos uma aniversariante no mês atual (demo)
    await db.clientes.update_one({"id": ids["Fernanda Costa"]},
                                 {"$set": {"birthdate": f"1994-{today.month:02d}-18"}})

    procedimentos = [
        ("Harmonização Facial", 3500), ("Toxina Botulínica", 1200), ("Preenchimento Labial", 1800),
        ("Bioestimulador de Colágeno", 2400), ("Lavieen", 900), ("Limpeza de Pele", 350),
        ("Peeling Químico", 600), ("Microagulhamento", 750),
    ]
    prof_list = [("Dra. Juliana Mendes", prof_ids.get("Dra. Juliana Mendes")),
                 ("Dr. Lucas Ferraz", prof_ids.get("Dr. Lucas Ferraz"))]

    import random
    random.seed(7)

    sessoes = []
    for name, cid in ids.items():
        for _ in range(random.randint(2, 4)):
            p = random.choice(procedimentos)
            pf = random.choice(prof_list)
            val = float(p[1])
            sessoes.append(Sessao(cliente_id=cid, procedure=p[0], professional=pf[0], professional_id=pf[1] or "",
                                  date=dstr(-random.randint(0, 75)), value=val,
                                  notes="Sessão realizada com bom resultado.").model_dump())
    await db.sessoes.insert_many(sessoes)
    # atualiza LTV
    for name, cid in ids.items():
        total = sum(s["value"] for s in sessoes if s["cliente_id"] == cid)
        await db.clientes.update_one({"id": cid}, {"$set": {"total_spent": total}})

    await db.anamneses.insert_many([
        Anamnese(cliente_id=ids["Camila Ribeiro"], skin_type="Mista", allergies="Nenhuma conhecida",
                 health_conditions="Nenhuma", medications="Nenhum", area="Face",
                 observations="Pele saudável, boa resposta a preenchimentos.").model_dump(),
        Anamnese(cliente_id=ids["Patrícia Almeida"], skin_type="Seca", allergies="Lidocaína (leve)",
                 health_conditions="Hipotireoidismo controlado", medications="Levotiroxina", area="Face e pescoço",
                 observations="Atenção ao uso de anestésicos.").model_dump(),
    ])

    appts = []
    future_slots = [
        ("Camila Ribeiro", "Toxina Botulínica", 2, "Confirmado"),
        ("Fernanda Costa", "Limpeza de Pele", 1, "Agendado"),
        ("Patrícia Almeida", "Bioestimulador de Colágeno", 4, "Confirmado"),
        ("Roberta Lima", "Peeling Químico", 3, "Agendado"),
        ("Camila Ribeiro", "Preenchimento Labial", 9, "Agendado"),
        ("Fernanda Costa", "Microagulhamento", 0, "Confirmado"),
    ]
    for name, proc, day, st in future_slots:
        pval = dict(procedimentos)[proc]
        pf = random.choice(prof_list)
        appts.append(Appointment(cliente_id=ids[name], cliente_name=name, professional=pf[0], professional_id=pf[1] or "",
                                 procedure=proc, datetime=f"{dstr(day)}T{random.choice(['09:00','11:00','14:00','16:00'])}:00",
                                 room=f"Sala {random.randint(1,3)}", status=st, value=float(pval)).model_dump())
    for name, cid in ids.items():
        for _ in range(random.randint(1, 2)):
            p = random.choice(procedimentos)
            pf = random.choice(prof_list)
            appts.append(Appointment(cliente_id=cid, cliente_name=name, professional=pf[0], professional_id=pf[1] or "",
                                     procedure=p[0], datetime=f"{dstr(-random.randint(3,60))}T14:00:00",
                                     room=f"Sala {random.randint(1,3)}", status="Concluído", value=float(p[1])).model_dump())
    await db.appointments.insert_many(appts)

    txs = []
    categorias_desp = [("Aluguel", 4500), ("Fornecedor de Insumos", 3200), ("Salários", 9800),
                       ("Marketing", 1500), ("Energia e Água", 900)]
    nomes_pool = list(ids.keys())
    for m in range(6):
        month_date = (today.replace(day=1) - timedelta(days=30 * m))
        base = month_date.replace(day=10).isoformat()
        for _ in range(random.randint(18, 22)):
            name = random.choice(nomes_pool)
            p = random.choice(procedimentos)
            st = "Pago" if (m > 0 or random.random() > 0.35) else random.choice(["Pendente", "Atrasado"])
            txs.append(Transaction(type="receita", description=f"{p[0]} - {name}", category=p[0],
                                   amount=float(p[1]), status=st, party=name,
                                   due_date=month_date.replace(day=random.randint(1, 28)).isoformat(),
                                   paid_date=base if st == "Pago" else "").model_dump())
        for cat, val in categorias_desp:
            st = "Pago" if m > 0 else random.choice(["Pago", "Pendente"])
            txs.append(Transaction(type="despesa", description=cat, category=cat, amount=float(val),
                                   status=st, party=cat, due_date=month_date.replace(day=5).isoformat(),
                                   paid_date=base if st == "Pago" else "").model_dump())
    await db.transactions.insert_many(txs)

    # produtos / estoque
    if await db.products.count_documents({}) == 0:
        produtos_seed = [
            ("Toxina Botulínica (frasco)", "Injetáveis", 12, 5, "frasco", 780, "Allergan"),
            ("Ácido Hialurônico 1ml", "Preenchedores", 8, 6, "seringa", 650, "Rennova"),
            ("Fio de PDG", "Bioestimulador", 3, 10, "un", 120, "Silhouette"),
            ("Luvas Nitrílicas", "Descartáveis", 240, 100, "par", 1.2, "Supermed"),
            ("Máscara Facial Calmante", "Cosméticos", 45, 20, "un", 18, "Dermage"),
            ("Anestésico Tópico", "Insumos", 2, 8, "tubo", 55, "EMLA"),
            ("Agulha 30G", "Descartáveis", 500, 200, "un", 0.6, "BD"),
            ("Álcool 70%", "Higiene", 30, 15, "L", 9, "Distribuidora Local"),
        ]
        await db.products.insert_many([
            Product(name=n, category=c, quantity=q, min_quantity=mq, unit=u, cost=cost, supplier=s).model_dump()
            for n, c, q, mq, u, cost, s in produtos_seed
        ])

    # galeria antes & depois
    if await db.gallery.count_documents({}) == 0:
        await db.gallery.insert_many([
            GalleryItem(cliente_id=ids["Camila Ribeiro"], title="Preenchimento Labial",
                        procedure="Preenchimento Labial", date=dstr(-30),
                        before_image="https://images.unsplash.com/photo-1616394584738-fc6e612e71b9?auto=format&fit=crop&w=600&q=80",
                        after_image="https://images.unsplash.com/photo-1620331311520-246422fd82f9?auto=format&fit=crop&w=600&q=80",
                        notes="Resultado natural com hidratação labial.").model_dump(),
            GalleryItem(cliente_id=ids["Patrícia Almeida"], title="Harmonização Facial",
                        procedure="Harmonização Facial", date=dstr(-60),
                        before_image="https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?auto=format&fit=crop&w=600&q=80",
                        after_image="https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?auto=format&fit=crop&w=600&q=80",
                        notes="Contorno facial definido, ótima simetria.").model_dump(),
        ])
    # catálogo de procedimentos
    if await db.procedures.count_documents({}) == 0:
        cat_map = {"Harmonização Facial": "Injetáveis", "Toxina Botulínica": "Injetáveis",
                   "Preenchimento Labial": "Preenchedores", "Bioestimulador de Colágeno": "Bioestimulador",
                   "Lavieen": "Laser", "Limpeza de Pele": "Estética Facial",
                   "Peeling Químico": "Estética Facial", "Microagulhamento": "Estética Facial"}
        dur_map = {"Harmonização Facial": 90, "Toxina Botulínica": 45, "Preenchimento Labial": 60,
                   "Bioestimulador de Colágeno": 60, "Lavieen": 40, "Limpeza de Pele": 60,
                   "Peeling Químico": 45, "Microagulhamento": 50}
        await db.procedures.insert_many([
            Procedure(name=n, category=cat_map.get(n, "Geral"), price=float(p),
                      duration_min=dur_map.get(n, 45),
                      description=f"Procedimento estético: {n}.").model_dump()
            for n, p in procedimentos
        ])
    logger.info("Seed concluído.")


@app.on_event("startup")
async def startup():
    await db.users.create_index("email", unique=True)
    await db.clientes.create_index("id", unique=True)
    await seed()

@app.on_event("shutdown")
async def shutdown_db_client():
    client.close()
