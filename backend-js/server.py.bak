# ---------------- WhatsApp ----------------
@api_router.get("/whatsapp/config")
async def get_wa_config(user: dict = Depends(require_roles("admin"))):
    cfg = await db.whatsapp_config.find_one({"id": "default"}, {"_id": 0})
    if not cfg:
        cfg = WhatsAppConfig().model_dump()
        await db.whatsapp_config.insert_one(cfg)
    # não expor token completo
    token = cfg.get("access_token") or ""
    safe = {**cfg, "access_token": ("***" + token[-4:]) if len(token) > 4 else token, "has_token": bool(token)}
    return safe

@api_router.put("/whatsapp/config")
async def put_wa_config(inp: WhatsAppConfigInput, user: dict = Depends(require_roles("admin"))):
    data = inp.model_dump()
    data["id"] = "default"
    data["updated_at"] = now_iso()
    if data.get("access_token", "").startswith("***"):
        existing = await db.whatsapp_config.find_one({"id": "default"}, {"_id": 0})
        if existing:
            data["access_token"] = existing.get("access_token", "")
    await db.whatsapp_config.update_one({"id": "default"}, {"$set": data}, upsert=True)
    return await get_wa_config(user)

