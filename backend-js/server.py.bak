# ---------------- Fluxo de caixa / Fechamentos ----------------
@api_router.get("/fluxo-caixa")
async def fluxo_caixa(from_date: Optional[str] = None, to_date: Optional[str] = None,
                      user: dict = Depends(require_roles("admin"))):
    txs = await db.transactions.find({}, {"_id": 0}).to_list(5000)
    sessoes = await db.sessoes.find({}, {"_id": 0}).to_list(5000)

    def in_range(d):
        if not d:
            return False
        d = d[:10]
        if from_date and d < from_date:
            return False
        if to_date and d > to_date:
            return False
        return True

    entradas = []
    saidas = []
    for t in txs:
        d = t.get("paid_date") or t.get("due_date") or ""
        if t.get("status") != "Pago" or not in_range(d):
            continue
        item = {"data": d[:10], "descricao": t.get("description", ""), "categoria": t.get("category", ""),
                "valor": t.get("amount", 0), "origem": "lancamento"}
        if t.get("type") == "receita":
            entradas.append(item)
        else:
            saidas.append(item)
    for s in sessoes:
        d = s.get("date") or ""
        if not in_range(d):
            continue
        entradas.append({"data": d[:10], "descricao": f"Sessão {s.get('procedure','')}", "categoria": s.get("procedure", ""),
                         "valor": s.get("value", 0), "origem": "sessao"})
    total_ent = sum(i["valor"] for i in entradas)
    total_sai = sum(i["valor"] for i in saidas)
    return {
        "entradas": sorted(entradas, key=lambda x: x["data"], reverse=True),
        "saidas": sorted(saidas, key=lambda x: x["data"], reverse=True),
        "total_entradas": total_ent,
        "total_saidas": total_sai,
        "saldo": total_ent - total_sai,
    }

@api_router.get("/fechamentos")
async def list_fechamentos(user: dict = Depends(require_roles("admin"))):
    return await db.fechamentos.find({}, {"_id": 0}).sort("created_at", -1).to_list(100)

@api_router.get("/fechamentos/preview")
async def preview_fechamento(periodo_inicio: str, periodo_fim: str, user: dict = Depends(require_roles("admin"))):
    fluxo = await fluxo_caixa(periodo_inicio, periodo_fim, user)
    appts = await db.appointments.find({}, {"_id": 0}).to_list(2000)
    atend = [a for a in appts if a.get("status") == "Concluído"
             and periodo_inicio <= (a.get("datetime") or "")[:10] <= periodo_fim]
    comissoes_data = await commissions(user)
    total_com = sum(c.get("commission", 0) for c in comissoes_data) if isinstance(comissoes_data, list) else 0
    return {
        "periodo_inicio": periodo_inicio,
        "periodo_fim": periodo_fim,
        "total_faturamento": fluxo["total_entradas"],
        "total_despesas": fluxo["total_saidas"],
        "total_comissoes": total_com,
        "lucro_liquido": fluxo["saldo"] - total_com,
        "total_atendimentos": len(atend),
    }

@api_router.post("/fechamentos")
async def create_fechamento(inp: FechamentoInput, user: dict = Depends(require_roles("admin"))):
    preview = await preview_fechamento(inp.periodo_inicio, inp.periodo_fim, user)
    obj = Fechamento(**preview, gerado_por_id=user["id"])
    await db.fechamentos.insert_one(obj.model_dump())
    return obj


