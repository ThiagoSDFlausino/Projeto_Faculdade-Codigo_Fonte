# ---------------- Appointments ----------------
@api_router.get("/appointments", response_model=List[Appointment])
async def list_appointments(from_date: Optional[str] = None, to_date: Optional[str] = None,
                            professional_id: Optional[str] = None, status: Optional[str] = None,
                            user: dict = Depends(get_current_user)):
    q = {}
    if user["role"] == "profissional":
        q["professional_id"] = user["id"]
    elif professional_id:
        q["professional_id"] = professional_id
    if status:
        q["status"] = status
    items = await db.appointments.find(q, {"_id": 0}).sort("datetime", 1).to_list(2000)
    if from_date:
        items = [a for a in items if (a.get("datetime") or "")[:10] >= from_date]
    if to_date:
        items = [a for a in items if (a.get("datetime") or "")[:10] <= to_date]
    return items

@api_router.post("/appointments", response_model=Appointment)
async def create_appointment(inp: AppointmentInput, user: dict = Depends(get_current_user)):
    data = inp.model_dump()
    if user["role"] == "profissional":
        data["professional_id"] = user["id"]
        data["professional"] = user["name"]
    elif data.get("professional_id"):
        prof = await db.users.find_one({"id": data["professional_id"]}, {"_id": 0})
        data["professional"] = prof["name"] if prof else ""
    obj = Appointment(**data)
    await db.appointments.insert_one(obj.model_dump())
    return obj

@api_router.put("/appointments/{appt_id}", response_model=Appointment)
async def update_appointment(appt_id: str, inp: AppointmentInput, user: dict = Depends(get_current_user)):
    existing = await db.appointments.find_one({"id": appt_id}, {"_id": 0})
    if not existing:
        raise HTTPException(status_code=404, detail="Agendamento não encontrado")
    if user["role"] == "profissional" and existing.get("professional_id") != user["id"]:
        raise HTTPException(status_code=404, detail="Agendamento não encontrado")
    data = inp.model_dump()
    if user["role"] == "profissional":
        data["professional_id"] = user["id"]
        data["professional"] = user["name"]
    elif data.get("professional_id"):
        prof = await db.users.find_one({"id": data["professional_id"]}, {"_id": 0})
        data["professional"] = prof["name"] if prof else existing.get("professional", "")
    existing.update(data)
    await db.appointments.update_one({"id": appt_id}, {"$set": data})
    return Appointment(**existing)

@api_router.delete("/appointments/{appt_id}")
async def delete_appointment(appt_id: str, user: dict = Depends(get_current_user)):
    existing = await db.appointments.find_one({"id": appt_id}, {"_id": 0})
    if not existing:
        raise HTTPException(status_code=404, detail="Agendamento não encontrado")
