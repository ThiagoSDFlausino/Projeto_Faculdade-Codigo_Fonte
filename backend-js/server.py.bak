@api_router.get("/tarefas/resumo")
async def tarefas_resumo(user: dict = Depends(get_current_user)):
    q = {}
    if user["role"] == "profissional":
        q["responsavel_id"] = user["id"]
    items = await db.tarefas.find(q, {"_id": 0}).to_list(1000)
    hoje = date.today().isoformat()
    pendentes = [t for t in items if t.get("status") == "pendente"]
    atrasadas = [t for t in pendentes if t.get("data_vencimento") and t["data_vencimento"] < hoje]
    return {
        "total": len(items),
        "pendentes": len(pendentes),
        "atrasadas": len(atrasadas),
        "concluidas": len([t for t in items if t.get("status") == "concluida"]),
        "proximas": sorted(pendentes, key=lambda x: x.get("data_vencimento") or "9999")[:5],
    }

@api_router.post("/tarefas")
async def create_tarefa(inp: TarefaInput, user: dict = Depends(get_current_user)):
    data = inp.model_dump()
    data["criado_por_id"] = user["id"]
    if data.get("responsavel_id"):
        prof = await db.users.find_one({"id": data["responsavel_id"]}, {"_id": 0})
        data["responsavel_nome"] = prof["name"] if prof else ""
    elif user["role"] == "profissional":
        data["responsavel_id"] = user["id"]
        data["responsavel_nome"] = user["name"]
    if data.get("cliente_id"):
        cli = await db.clientes.find_one({"id": data["cliente_id"]}, {"_id": 0})
        data["cliente_nome"] = cli["name"] if cli else ""
    obj = Tarefa(**data)
    await db.tarefas.insert_one(obj.model_dump())
    return obj

@api_router.put("/tarefas/{tarefa_id}")
async def update_tarefa(tarefa_id: str, inp: TarefaInput, user: dict = Depends(get_current_user)):
    existing = await db.tarefas.find_one({"id": tarefa_id}, {"_id": 0})
    if not existing:
        raise HTTPException(status_code=404, detail="Tarefa não encontrada")
    data = inp.model_dump()
    if data.get("responsavel_id"):
        prof = await db.users.find_one({"id": data["responsavel_id"]}, {"_id": 0})
        data["responsavel_nome"] = prof["name"] if prof else ""
    if data.get("cliente_id"):
        cli = await db.clientes.find_one({"id": data["cliente_id"]}, {"_id": 0})
        data["cliente_nome"] = cli["name"] if cli else ""
    data["updated_at"] = now_iso()
    await db.tarefas.update_one({"id": tarefa_id}, {"$set": data})
    return await db.tarefas.find_one({"id": tarefa_id}, {"_id": 0})

@api_router.put("/tarefas/{tarefa_id}/status")
