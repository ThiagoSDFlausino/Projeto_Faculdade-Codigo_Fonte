# ---------------- Auth ----------------
@api_router.post("/auth/register")
async def register(inp: RegisterInput):
    email = inp.email.lower()
    if await db.users.find_one({"email": email}):
        raise HTTPException(status_code=400, detail="E-mail já cadastrado")
    uid = str(uuid.uuid4())
    doc = {"id": uid, "email": email, "password_hash": hash_password(inp.password),
           "name": inp.name, "role": "admin", "specialty": "", "commission_pct": 0,
           "photo": "", "active": True, "created_at": now_iso()}
    await db.users.insert_one(doc)
    return {"token": create_access_token(uid, email), "user": public_user(doc)}

@api_router.post("/auth/login")
async def login(inp: LoginInput):
    email = inp.email.lower()
    user = await db.users.find_one({"email": email})
    if not user or not verify_password(inp.password, user["password_hash"]):
        raise HTTPException(status_code=401, detail="Credenciais inválidas")
    if not user.get("active", True):
        raise HTTPException(status_code=403, detail="Usuário desativado")
    return {"token": create_access_token(user["id"], email), "user": public_user(user)}

@api_router.get("/auth/me")
async def me(user: dict = Depends(get_current_user)):
    return user


# ---------------- Staff (Equipe) — admin only ----------------
@api_router.get("/staff")
async def list_staff(user: dict = Depends(require_roles("admin"))):
    docs = await db.users.find({}, {"_id": 0, "password_hash": 0}).sort("name", 1).to_list(200)
    return [public_user(d) for d in docs]

@api_router.get("/professionals")
async def list_professionals(user: dict = Depends(require_roles("admin", "secretaria", "profissional"))):
    docs = await db.users.find({"role": "profissional", "active": True}, {"_id": 0}).sort("name", 1).to_list(200)
    return [{"id": d["id"], "name": d["name"], "specialty": d.get("specialty", "")} for d in docs]

@api_router.post("/staff")
async def create_staff(inp: StaffInput, user: dict = Depends(require_roles("admin"))):
    if inp.role not in ROLES:
        raise HTTPException(status_code=400, detail="Perfil inválido")
    email = inp.email.lower()
    if await db.users.find_one({"email": email}):
        raise HTTPException(status_code=400, detail="E-mail já cadastrado")
    uid = str(uuid.uuid4())
    doc = {"id": uid, "email": email, "password_hash": hash_password(inp.password),
           "name": inp.name, "role": inp.role, "specialty": inp.specialty,
           "commission_pct": inp.commission_pct, "photo": inp.photo, "active": True, "created_at": now_iso()}
    await db.users.insert_one(doc)
    return public_user(doc)

@api_router.put("/staff/{staff_id}")
async def update_staff(staff_id: str, inp: StaffUpdate, user: dict = Depends(require_roles("admin"))):
    if inp.role not in ROLES:
        raise HTTPException(status_code=400, detail="Perfil inválido")
    res = await db.users.update_one({"id": staff_id}, {"$set": {
        "name": inp.name, "role": inp.role, "specialty": inp.specialty,
        "commission_pct": inp.commission_pct, "active": inp.active, "photo": inp.photo}})
    if res.matched_count == 0:
        raise HTTPException(status_code=404, detail="Membro não encontrado")
    doc = await db.users.find_one({"id": staff_id}, {"_id": 0})
    return public_user(doc)

@api_router.delete("/staff/{staff_id}")
async def delete_staff(staff_id: str, user: dict = Depends(require_roles("admin"))):
    if staff_id == user["id"]:
        raise HTTPException(status_code=400, detail="Você não pode remover a si mesmo")
    res = await db.users.delete_one({"id": staff_id})
    if res.deleted_count == 0:
        raise HTTPException(status_code=404, detail="Membro não encontrado")
    return {"ok": True}


# ---------------- Clientes ----------------
@api_router.get("/clientes", response_model=List[Cliente])
async def list_clientes(user: dict = Depends(get_current_user)):
    return await db.clientes.find({}, {"_id": 0}).sort("name", 1).to_list(1000)

@api_router.get("/clientes/{cliente_id}")
async def get_cliente(cliente_id: str, user: dict = Depends(get_current_user)):
    doc = await db.clientes.find_one({"id": cliente_id}, {"_id": 0})
    if not doc:
        raise HTTPException(status_code=404, detail="Cliente não encontrado")
    sess_q = {"cliente_id": cliente_id}
    appt_q = {"cliente_id": cliente_id}
    if user["role"] == "profissional":
        sess_q["professional_id"] = user["id"]
        appt_q["professional_id"] = user["id"]
    anamneses = await db.anamneses.find({"cliente_id": cliente_id}, {"_id": 0}).sort("created_at", -1).to_list(100)
    sessoes = await db.sessoes.find(sess_q, {"_id": 0}).sort("date", -1).to_list(100)
    appts = await db.appointments.find(appt_q, {"_id": 0}).sort("datetime", -1).to_list(100)
    gallery = await db.gallery.find({"cliente_id": cliente_id}, {"_id": 0}).sort("created_at", -1).to_list(100)
    notas = await db.notas_cliente.find({"cliente_id": cliente_id}, {"_id": 0}).sort("created_at", -1).to_list(100)
    lembretes = await db.lembretes.find({"cliente_id": cliente_id}, {"_id": 0}).sort("data_vencimento", 1).to_list(100)
    avaliacoes = await db.avaliacoes_cliente.find({"cliente_id": cliente_id}, {"_id": 0}).sort("created_at", -1).to_list(100)
    interacoes = await db.interacoes_cliente.find({"cliente_id": cliente_id}, {"_id": 0}).sort("created_at", -1).to_list(100)
    pacotes = await db.pacotes.find({"cliente_id": cliente_id}, {"_id": 0}).sort("created_at", -1).to_list(100)
    return {
        "cliente": doc, "anamneses": anamneses, "sessoes": sessoes, "appointments": appts, "gallery": gallery,
        "notas": notas, "lembretes": lembretes, "avaliacoes": avaliacoes, "interacoes": interacoes, "pacotes": pacotes,
    }

@api_router.post("/clientes", response_model=Cliente)
async def create_cliente(inp: ClienteInput, user: dict = Depends(get_current_user)):
    obj = Cliente(**inp.model_dump())
    await db.clientes.insert_one(obj.model_dump())
    return obj

@api_router.put("/clientes/{cliente_id}", response_model=Cliente)
async def update_cliente(cliente_id: str, inp: ClienteInput, user: dict = Depends(get_current_user)):
    existing = await db.clientes.find_one({"id": cliente_id}, {"_id": 0})
    if not existing:
        raise HTTPException(status_code=404, detail="Cliente não encontrado")
    existing.update(inp.model_dump())
    await db.clientes.update_one({"id": cliente_id}, {"$set": inp.model_dump()})
    return Cliente(**existing)

@api_router.delete("/clientes/{cliente_id}")
async def delete_cliente(cliente_id: str, user: dict = Depends(require_roles("admin", "secretaria"))):
    res = await db.clientes.delete_one({"id": cliente_id})
    if res.deleted_count == 0:
        raise HTTPException(status_code=404, detail="Cliente não encontrado")
    for col in ("sessoes", "anamneses", "appointments", "gallery", "notas_cliente", "lembretes",
                "avaliacoes_cliente", "interacoes_cliente", "pacotes"):
        await db[col].delete_many({"cliente_id": cliente_id})
    return {"ok": True}


# ---------------- Anamnese / Sessao ----------------
@api_router.post("/anamneses", response_model=Anamnese)
async def create_anamnese(inp: AnamneseInput, user: dict = Depends(get_current_user)):
    if not await db.clientes.find_one({"id": inp.cliente_id}):
        raise HTTPException(status_code=404, detail="Cliente não encontrado")
    obj = Anamnese(**inp.model_dump())
    await db.anamneses.insert_one(obj.model_dump())
    return obj

@api_router.post("/sessoes", response_model=Sessao)
async def create_sessao(inp: SessaoInput, user: dict = Depends(get_current_user)):
    if not await db.clientes.find_one({"id": inp.cliente_id}):
        raise HTTPException(status_code=404, detail="Cliente não encontrado")
    data = inp.model_dump()
    if user["role"] == "profissional":
        data["professional_id"] = user["id"]
        data["professional"] = user["name"]
    elif data.get("professional_id"):
        prof = await db.users.find_one({"id": data["professional_id"]}, {"_id": 0})
        data["professional"] = prof["name"] if prof else ""
    obj = Sessao(**data)
    await db.sessoes.insert_one(obj.model_dump())
    if obj.value:
        await db.clientes.update_one({"id": obj.cliente_id}, {"$inc": {"total_spent": obj.value}})
    # consome pacote ativo do mesmo procedimento se houver
    pacote_q = {"cliente_id": obj.cliente_id, "status": "ativo"}
    if obj.procedure:
        pacote_q["procedure_nome"] = obj.procedure
    pacote = await db.pacotes.find_one(pacote_q, {"_id": 0})
    if pacote and pacote.get("usadas", 0) < pacote.get("total_sessoes", 0):
        novas = pacote["usadas"] + 1
        upd = {"usadas": novas}
        if novas >= pacote["total_sessoes"]:
            upd["status"] = "esgotado"
        await db.pacotes.update_one({"id": pacote["id"]}, {"$set": upd})
    return obj


