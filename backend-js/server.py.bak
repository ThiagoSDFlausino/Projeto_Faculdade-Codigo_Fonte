        raise HTTPException(status_code=404, detail="Lead não encontrado")
    return await db.leads.find_one({"id": lead_id}, {"_id": 0})

@api_router.post("/leads/{lead_id}/converter")
async def convert_lead(lead_id: str, user: dict = Depends(require_roles("admin", "secretaria"))):
    lead = await db.leads.find_one({"id": lead_id}, {"_id": 0})
    if not lead:
        raise HTTPException(status_code=404, detail="Lead não encontrado")
    if lead.get("convertido_cliente_id"):
        return {"cliente_id": lead["convertido_cliente_id"], "already": True}
    cli = Cliente(name=lead["nome"], phone=lead.get("telefone", ""), email=lead.get("email", ""),
                  tags=["Lead convertido"], notes=f"Convertido do lead. Interesse: {lead.get('interesse','')}")
    await db.clientes.insert_one(cli.model_dump())
    await db.leads.update_one({"id": lead_id}, {"$set": {
        "estagio": "ganho", "convertido_cliente_id": cli.id, "updated_at": now_iso()
    }})
    return {"cliente_id": cli.id, "cliente": cli.model_dump()}

