# Exemplo para Container / produção Cloudflare
NODE_ENV=production
DATABASE_MODE=d1
PORT=8080
TRUST_PROXY=1

# Obrigatório: string aleatória >= 24 caracteres
JWT_SECRET=
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

ADMIN_EMAIL=admin@sua-clinica.com
ADMIN_PASSWORD=

# URL do Cloudflare Pages (sem *)
CORS_ORIGINS=https://suleima-estetica.pages.dev

# ALLOW_PUBLIC_REGISTER=0
AUTH_RATE_LIMIT=30
API_RATE_LIMIT=300
JSON_BODY_LIMIT=6mb
