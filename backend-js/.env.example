# sqlite (local) | supabase | d1 (Cloudflare Container)
DATABASE_MODE=sqlite
# DATABASE_URL=file:./data/dev.sqlite
# DATABASE_URL=:memory:

# Supabase — URI do Postgres (Session/Direct, porta 5432).
# Se a senha tiver @ ou $, codifique (%40 e %24).
# DATABASE_MODE=supabase
# DATABASE_URL=postgresql://postgres:[SENHA]@db.[ref].supabase.co:5432/postgres
# SUPABASE_URL=https://[ref].supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=https://[ref].supabase.co/auth/v1/.well-known/jwks.json

# Obrigatório em produção: string aleatória >= 24 caracteres
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

ADMIN_EMAIL=admin@sua-clinica.com
ADMIN_PASSWORD=troque-esta-senha-forte

PORT=8000
# Em produção: URL(s) do frontend, separadas por vírgula — NUNCA use *
CORS_ORIGINS=http://localhost:3000

# Limites (opcional)
# AUTH_RATE_LIMIT=30
# API_RATE_LIMIT=300
# JSON_BODY_LIMIT=6mb
# TRUST_PROXY=1

# Cadastro público (POST /auth/register) — deixe desligado; use Equipe
# ALLOW_PUBLIC_REGISTER=0
