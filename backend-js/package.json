{
  "name": "bella-gestao-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "db:supabase": "node scripts/copy-sqlite-to-supabase.js",
    "test": "node --import ./tests/setup-env.js --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --import ./tests/setup-env.js --test tests/unit/*.test.js",
    "test:integration": "node --import ./tests/setup-env.js --test --test-concurrency=1 tests/integration/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.23.1",
    "uuid": "^11.1.0"
  }
}
